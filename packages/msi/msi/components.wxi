<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Referenced by the ConfigureMondooServiceRecovery custom action to
           locate the native 64-bit sc.exe. WiX v3 requires standard
           directories to be declared before they can be referenced. -->
      <Directory Id="System64Folder" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLLOCATION" Name="Mondoo" />
      </Directory>
    </Directory>

  <ComponentGroup Id="MondooClient">
      <!-- Lets the installed binary find its own Add/Remove entry after it
           self-updates, so the version Windows reports tracks the binary
           rather than whatever shipped in this MSI.

           The ProductCode has to be published here because nothing else can
           know it: Product carries Id="*", so it is regenerated on every
           build. The UpgradeCode is stable but differs per SKU and per
           architecture, which would mean compiling three GUIDs and the rules
           for choosing between them into the binary. The installer already
           knows which package it is; it writes that down instead.

           Version is the true version, pre-release segment included. The
           ProductVersion above cannot carry it, because Windows Installer
           accepts numeric fields only, so this is the one place the exact
           build is recorded. -->
      <!-- UPDATECHANNEL=preview at install time puts the machine on the
           pre-release track, which is otherwise only settable by editing
           mondoo.yml after the fact — awkward for a fleet deployment, and the
           channel is the one client-side control the whole preview mechanism
           has.

           A machine environment variable rather than a config file write:
           MONDOO_UPDATE_CHANNEL binds to the update_channel setting through
           viper's env prefix, so no new plumbing is needed on the client, and
           the service running as LocalSystem reads machine variables. The MSI
           already sets PATH the same way.

           Not Permanent, so it is removed with the package, and conditioned so
           a normal install writes nothing: an env var outranks mondoo.yml, and
           silently overriding a file the admin edited later would be a nasty
           surprise for someone who never asked for the pinning. -->
      <!-- Three identifiers appear below and they are easy to confuse:
             UPDATECHANNEL          the MSI property an installer passes on the
                                    command line. Uppercase because Windows
                                    Installer only treats uppercase properties
                                    as public.
             UpdateChannelEnv       this component's Id. WiX needs one per
                                    component; it is never seen outside the
                                    package.
             MONDOO_UPDATE_CHANNEL  the environment variable actually written,
                                    and the only one cnspec reads.
           The Environment element needs an Id of its own as well, for the same
           WiX bookkeeping reason as the component. -->
      <Component Id="UpdateChannelEnv" Win64="yes" Directory="INSTALLLOCATION" Guid="3f7a2b91-5c8d-4e16-a0b4-7d29e6c31f58">
        <Condition><![CDATA[UPDATECHANNEL <> ""]]></Condition>
        <!-- An Environment element cannot be a component's KeyPath, so without
             this WiX falls back to the directory and ICE18 rejects the build:
             a directory KeyPath has to appear in the CreateFolders table.
             INSTALLLOCATION is created by the other components regardless, so
             this only satisfies the rule. -->
        <CreateFolder />
        <Environment Id="MondooUpdateChannelVar" Name="MONDOO_UPDATE_CHANNEL" Value="[UPDATECHANNEL]" System="yes" Action="set" Part="all" />
      </Component>
      <Component Id="InstallRegistration" Win64="yes" Directory="INSTALLLOCATION" Guid="9a4c1f7e-6d21-4f0b-9f3e-1c2d5a7b8e04">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Mondoo" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="ProductCode" Type="string" Value="[ProductCode]" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLLOCATION]" />
        </RegistryKey>
      </Component>
      <Component Id="ServiceFiles" Win64="yes" Directory="INSTALLLOCATION">
        <!-- Set binary into System Path-->
        <Environment Id="PATH" Name="PATH" Value="[INSTALLLOCATION]" Permanent="yes" Part="last" Action="set" System="yes" />
        <!-- Mondoo Binary -->
        <File Id="ApplicationFileEXE" Source="cnspec.exe" />
        <!-- Install the Service -->

        <ServiceInstall Id="ServiceInstaller" Type="ownProcess" Vital="yes" Name="Mondoo" DisplayName="Mondoo"
                        Description="Verifies your system for known vulnerabilities"
                        Start="$(var.ServiceInstallStart)"
                        Account="LocalSystem"
                        ErrorControl="normal" Arguments=" serve --config C:\ProgramData\Mondoo\mondoo.yml" Interactive="no" />
        <?if $(var.ServiceInstallStart) = "auto" ?>
        <ServiceControl Id="StartWixServiceInstaller" Name="Mondoo" Start="install" Stop="uninstall" Wait="no" Remove="uninstall" />
        <?else?>
        <ServiceControl Id="StartWixServiceInstaller" Name="Mondoo" Stop="uninstall" Wait="no" Remove="uninstall" />
        <?endif?>

      </Component>

      <Component Id="mql" Win64="yes" Directory="INSTALLLOCATION">
        <File Id="mqlEXE" Source="mql.exe" />
      </Component>

      <Component Id="cnquery" Win64="yes" Directory="INSTALLLOCATION">
        <File Id="cnqueryEXE" Source="cnquery.exe" />
      </Component>
  </ComponentGroup>
</Include>
